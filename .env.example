# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Public origin the browser uses (dev: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database: leave empty in development to use local PGlite (.data/pglite).
# Required in production (Neon / any PostgreSQL), e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# Email: "console" (default when no key) or "brevo"
EMAIL_PROVIDER=console
BREVO_API_KEY=
# Must be a sender address verified in Brevo
EMAIL_FROM=relay@example.com
EMAIL_FROM_NAME=Relay Care

# Set to 1 only when running behind a trusted reverse proxy (Cloud Run, Render)
TRUST_PROXY=0
